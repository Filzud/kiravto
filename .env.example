# Скопируйте в .env командой `python -m kiravto secrets` (секреты вводятся скрытым вводом).
# Значения ниже — не секреты, их можно менять руками.
DEALER_CODE=rolf_yasenevo_moskva
DEALER_ID=20866489
RUN_INTERVAL_MIN=45
COMPLETENESS_THRESHOLD=0.9
SOLD_AFTER_DAYS=7
MAX_CARDS_PER_RUN=120
# карточки, которые освежаются по кругу (выдача Авто.ру отстаёт, цены берём из карточек)
REFRESH_CARDS_PER_RUN=60
DROP_MIN_PCT=3
DAILY_POST_TIME=10:00
TZ_NAME=Europe/Moscow

# Telegram
TG_BOT_TOKEN=
TG_ADMIN_CHAT_ID=
TG_TEST_CHANNEL_ID=
TG_PROD_CHANNEL_ID=
# test — всё уходит в тестовый канал. Переключить на боевой может только человек, правкой этого файла.
TG_PUBLISH_TARGET=test
TG_API_BASE=https://api.telegram.org
# если Telegram доступен только через прокси, например http://127.0.0.1:10809
TG_PROXY=

# HTTP API
API_TOKEN=
API_PORT=8080

# LLM (пусто — функция фактов выключена, сервис работает без неё)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
# если провайдер доступен только через прокси, например http://127.0.0.1:10809 (в docker compose задан сам)
LLM_PROXY=
LLM_DAILY_BUDGET_USD=0.20
LLM_PRICE_IN_PER_M=0.15
LLM_PRICE_OUT_PER_M=0.60

# «Ниже рынка»: групп похожих машин за прогон, сколько часов выборка свежая, минимум похожих для оценки
MARKET_GROUPS_PER_RUN=12
MARKET_TTL_HOURS=48
MARKET_MIN_COMPS=5
# задано число N — в посты попадают только машины дешевле медианы рынка на N % и больше; пусто — фильтр выключен
MARKET_BELOW_PCT=

# Второй источник — сайт салона rolf.ru (38 — «РОЛЬФ Ясенево» в фильтре сайта)
ROLF_DEALER_ID=38
ROLF_INTERVAL_HOURS=6

# Голосовые вопросы в админ-чате: модель распознавания faster-whisper (tiny/base/small); off — выключено
STT_MODEL=small

# Google Таблица: ID таблицы и путь к JSON-ключу сервисного аккаунта (файл кладёт человек, в git он не попадает)
GSHEET_ID=
GSHEET_CREDENTIALS=
GSHEET_INTERVAL_HOURS=3
